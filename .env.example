# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- Database (Supabase Postgres) ---
# Pooled connection (used by the app at runtime, e.g. Supabase's PgBouncer port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct connection (used by Prisma Migrate, e.g. Supabase's direct port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Authentication ---
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# --- Environment ---
NODE_ENV="development"

# --- Seed script credentials (dev/staging only) ---
# Required explicitly in production; dev defaults exist in prisma/seed.ts
# but should not be relied on outside local development.
SEED_ADMIN_EMAIL="admin@leadflow.dev"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_MEMBER_EMAIL="member@leadflow.dev"
SEED_MEMBER_PASSWORD="replace-with-a-strong-password"
